# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b-mlx
TEMPERATURE=0.2

# Agent Settings
THREAD_ID=default-session
MAX_CONTEXT_TOKENS=12000
RECURSION_LIMIT=15
MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=120
OLLAMA_REQUEST_TIMEOUT_SECONDS=60
OLLAMA_HEALTH_TIMEOUT_SECONDS=3

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
API_MAX_MESSAGE_CHARS=20000
IDEMPOTENCY_TTL_SECONDS=3600
IDEMPOTENCY_MAX_ENTRIES=1000

# PostgreSQL Settings (APIの永続化を有効にする場合はコメント解除)
# DATABASE_URL=postgresql+asyncpg://langgraph:password@192.168.100.2:5432/langgraph
# CHECKPOINT_DATABASE_URL=postgresql://langgraph:password@192.168.100.2:5432/langgraph
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
EXECUTION_LEASE_SECONDS=300
CONVERSATION_RETENTION_DAYS=90
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_SUBJECT=local-anonymous-user
