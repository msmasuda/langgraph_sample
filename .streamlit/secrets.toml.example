[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "十分に長いランダム文字列へ変更してください"
client_id = "langgraph-streamlit"
client_secret = "Keycloak管理画面で取得したクライアントシークレット"
server_metadata_url = "http://192.168.100.2:8080/realms/langgraph/.well-known/openid-configuration"
expose_tokens = "access"
